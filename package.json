{
	"name": "nuxt-app",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"test": "vitest",
		"typecheck": "npx tsc -p .nuxt/tsconfig.app.json --noEmit && npx tsc -p .nuxt/tsconfig.shared.json --noEmit",
		"lint": "npx @biomejs/biome lint --write",
		"format": "npx @biomejs/biome format --write"
	},
	"dependencies": {
		"nuxt": "^4.4.8",
		"vue": "^3.5.35",
		"vue-router": "^5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@nuxt/test-utils": "^4.0.3",
		"@testing-library/vue": "^8.1.0",
		"@vitest/coverage-v8": "^4.1.9",
		"@vue/test-utils": "^2.4.11",
		"happy-dom": "^20.10.5",
		"jsdom": "^29.1.1",
		"playwright-core": "^1.61.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.9"
	}
}
