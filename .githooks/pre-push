#!/usr/bin/env bash
# Pre-push hook: block pushes unless the whole project passes the same checks CI
# runs: read-only Biome check, typecheck (when nuxt prepare configs exist) and
# the full Vitest suite.
#
# Install: npm run hooks   (sets core.hooksPath to .githooks)

set -euo pipefail

echo "pre-push: checking formatting/linting (read-only)..."
npx @biomejs/biome check .

# Typecheck needs the configs generated by `nuxt prepare` (postinstall). Skip it
# when they are missing so the hook never fails for an environmental reason.
if [[ -f .nuxt/tsconfig.app.json && -f .nuxt/tsconfig.shared.json ]]; then
    echo "pre-push: typechecking..."
    npm run typecheck
else
    echo "pre-push: skipped typecheck (.nuxt configs missing; run npm run dev or nuxt prepare first)"
fi

echo "pre-push: running tests..."
npx vitest run

echo "pre-push: all checks passed."
